// +------------------------------------------------------------------+
//  EXAMPLE 1: TC-DMRG[SS] with a 2x2 Real-Space Fermi-Hubbard Lattice 
// +------------------------------------------------------------------+

// -- General parameters --
nsweeps                     = 20
L                           = 4
max_bond_dimension          = 100
width_FermiHubbard          = 2
height_FermiHubbard         = 2
max_bond_dimension          = 50
U_FermiHubbard              = 4
symmetry                    = 2u1
site_types                  = "0,0,0,0"
MODEL                       = "fermi_hubbard_real"
u1_total_charge1            = 2
u1_total_charge2            = 1
optmization                 = "singlesite"

// -- MPS Initialization --
init_state                  = "hf"
hf_occ                      = "4,3,1,1"

// -- Noise --
alpha_initial               = 1.0E-8
alpha_main                  = 1.0E-15
alpha_final                 = 1.0E-30

// -- TD-specific quantities --
propagator_maxiter          = 10
propagator_accuracy         = 1.0E-10
imaginary_time              = "yes"
TD_backpropagation          = "no"
simulation_type             = TD
COMPLEX                     = 1
time_units                  = as
time_step                   = 10

// -- Transcorrelated parameters -- 
transcorrelated_hamiltonian = "yes"
J_Transcorrelated           = 0.5 
hamiltonian_units           = Hartree

// -- Initialization and storage information --
chkpfile                    = 'FH_RealSpace_2x2_2alpha1beta_TCDMRG_SS.checkpoint_state.0.h5'
resultfile                  = 'FH_RealSpace_2x2_2alpha1beta_TCDMRG_SS.results_state.0.h5'
