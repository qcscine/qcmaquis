// +-----------------------------------------------------------------+
//  EXAMPLE: TC-DMRG[S] with a 2x2 Real-Space Fermi-Hubbard Lattice 
// +----------------------------------------------------------------+

// -- General parameters --
simulation_type             = "transcorrelation"
transcorrelated_nsweep_TI   = 10
transcorrelated_nsweep_TC   = 10
L                           = 4
max_bond_dimension          = 100
width_FermiHubbard          = 2
height_FermiHubbard         = 2
max_bond_dimension          = 50
U_FermiHubbard              = 4
symmetry                    = 2u1
site_types                  = "0,0,0,0"
MODEL                       = "fermi_hubbard_real"
u1_total_charge1            = 2
u1_total_charge2            = 1
optimization                = "twosite"

// -- MPS Initialization --
init_state                  = "hf"
hf_occ                      = "4,3,1,1"

// -- TD-specific quantities --
propagator_maxiter          = 10
propagator_accuracy         = 1.0E-10
TD_backpropagation          = "no"
time_units                  = as
time_step                   = 10

// -- Transcorrelated parameters -- 
J_Transcorrelated           = 0.5 
hamiltonian_units           = Hartree

// -- Initialization and storage information --
chkpfile                    = 'FH_RealSpace_2x2_2alpha1beta_TCDMRG_TS.checkpoint_state.0.h5'
resultfile                  = 'FH_RealSpace_2x2_2alpha1beta_TCDMRG_TS.resfile.0.h5'
