// +------------------------------------------------------------------+
//  EXAMPLE 1: TI-DMRG[SS] with a 2x2 Real-Space Fermi-Hubbard Lattice 
// +------------------------------------------------------------------+

// -- General parameters --
nsweeps                     = 20
L                           = 4
max_bond_dimension          = 100
max_bond_dimension          = 50
symmetry                    = 2u1
site_types                  = "0,0,0,0"
MODEL                       = "fermi_hubbard_real"
u1_total_charge1            = 2
u1_total_charge2            = 1
optimization                = "twosite"

// -- Fermi-Hubbard specific parameters --
width_FermiHubbard          = 2
height_FermiHubbard         = 2
U_FermiHubbard              = 4
tx_FermiHubbard             = -1.5
ty_FermiHubbard             = -1.25

// -- MPS Initialization --
init_state                  = "hf"
hf_occ                      = "4,3,1,1"

// -- Initialization and storage information --
chkpfile                    = 'FH_RealSpaceAsymmetric_2x2_2alpha1beta_TIDMRG_TS.checkpoint_state.0.h5'
resultfile                  = 'FH_RealSpaceAsymmetric_2x2_2alpha1beta_TIDMRG_TS.results_state.0.h5'
